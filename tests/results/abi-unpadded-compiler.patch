+// Copy only validated payload bytes and clear the final allocated padding word.
+// In particular, a bounded memory input may have unrelated data after its end.
+fn copy_dynamic_bytes<I: ByteInput>(_ input: I, _ pos: u256, _ dest: *u8, _ data_len: u256, _ size: u256) {
+    let actual_size = 32 + data_len
+    if actual_size % 32 == 0 {
+        input.copy_to_memory_unchecked_aligned(dest: dest, src_offset: pos, len: actual_size)
+    } else {
+        store_word(ptr: ptr_offset(dest, size - 32), value: 0)
+        input.copy_to_memory(dest: dest, src_offset: pos, len: actual_size)
+    }
