+++ b/crates/fe/tests/fixtures/fe_test/composed_abi_decoder.fe
@@ -0,0 +1,77 @@
+use core::abi::{AbiSize, AbiSpan, AbiDecoder, ByteInput, Decode, Encode}
+use std::abi::{Sol, sol}
+use std::evm::Address
+pub struct Pair { pub a: Address, pub b: Address }
+impl Copy for Pair {}
+impl AbiSize for Pair {
+    const HEAD_SIZE: u256 = 64
+    const IS_DYNAMIC: bool = false
+}
+impl AbiSpan<Sol> for Pair {
+    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 {
+        pos + 64
+    }
+}
+impl Decode<Sol> for Pair {
+    fn decode_payload<D: AbiDecoder<Sol>>(_ d: mut D) -> Self {
+        let a = <Address as Decode<Sol>>::decode_payload(mut d)
+        let b = <Address as Decode<Sol>>::decode_payload(mut d)
+        Self { a, b }
+    }
+}
+impl Encode<Sol> for Pair {
+    fn encode(own self, _ ptr: *u8) {
+        <(Address, Address) as Encode<Sol>>::encode((self.a, self.b), ptr)
+    }
+}
+msg PairMsg {
+    #[selector = 0x11223344]
+    Echo { pair: Pair } -> Pair,
+}
+pub contract PairProbe {
+    recv PairMsg {
+        Echo { pair } -> Pair {
+            pair
+        }
+    }
+}
+
+use core::ptr::{self, MemBuffer}
+use std::evm::{Evm, RawMem, Call}
+fn check_pair(_ a: u256, _ b: u256, _ valid: bool) uses (evm: mut Evm) {
+    let receiver = evm.create2<PairProbe>(value: 0, args: (), salt: 0)
+    assert!(receiver.inner != 0)
+    let data = MemBuffer::alloc(68)
+    evm.mstore(addr: data.ptr(), value: (0x11223344 as u256) << 224)
+    evm.mstore(addr: ptr::offset_bytes(data.ptr(), 4), value: a)
+    evm.mstore(addr: ptr::offset_bytes(data.ptr(), 36), value: b)
+    let mut ret = MemBuffer::alloc(64)
+    let outcome = evm
+        .raw_call(
+            addr: receiver,
+            gas: 1000000,
+            value: 0,
+            args: data.span(),
+            ret: mut ret,
+        )
+    assert!(outcome.success() == valid)
+    if valid {
+        assert!(outcome.returndata_len() == 64)
+        assert!(evm.mload(ret.ptr()) == a)
+        assert!(evm.mload(ptr::offset_bytes(ret.ptr(), 32)) == b)
+    } else {
+        assert!(outcome.returndata_len() == 0)
+    }
+}
+#[test]
+fn composed_addresses_roundtrip() uses (evm: mut Evm) {
+    check_pair(0x1234, ((1 as u256) << 160) - 1, true)
+}
+#[test]
+fn composed_first_address_rejects_noncanonical_word() uses (evm: mut Evm) {
+    check_pair((1 as u256) << 160, 0, false)
+}
+#[test]
+fn composed_second_address_rejects_noncanonical_word() uses (evm: mut Evm) {
+    check_pair(0, (1 as u256) << 160, false)
+}
diff --git a/crates/fe/tests/fixtures/fe_test/ctfe_view_int_bitnot.fe b/crates/fe/tests/fixtures/fe_test/ctfe_view_int_bitnot.fe
new file mode 100644
index 000000000..f8ad2e376
--- /dev/null
+++ b/crates/fe/tests/fixtures/fe_test/ctfe_view_int_bitnot.fe
@@ -0,0 +1,44 @@
+// Bitwise-not of a cast literal is folded while its result has a view type.
+// The folded constant must keep the width of the viewed integer.
+
+fn is_u8_max(_ x: u8) -> bool {
+    x == !(0 as u8)
+}
+
+fn is_u16_max(_ x: u16) -> bool {
+    x == !(0 as u16)
+}
+
+fn is_u128_max(_ x: u128) -> bool {
+    x == !(0 as u128)
+}
+
+fn is_u256_max(_ x: u256) -> bool {
+    x != 0 && x == !(0 as u256)
+}
+
+fn is_i8_minus_one(_ x: i8) -> bool {
+    x == !(0 as i8)
+}
+
+fn is_not_five(_ x: i256) -> bool {
+    x == !(5 as i256)
+}
+
+fn clear_low_byte(_ x: u16) -> u16 {
+    x & !(255 as u16)
+}
+
+#[test]
+fn bitnot_of_cast_literal_uses_viewed_width() {
+    assert(is_u8_max(255))
+    assert(!is_u8_max(254))
+    assert(is_u16_max(65535))
+    assert(is_u128_max(340282366920938463463374607431768211455))
+    assert(is_u256_max(115792089237316195423570985008687907853269984665640564039457584007913129639935))
+    assert(!is_u256_max(1))
+    assert(is_i8_minus_one(-1))
+    assert(!is_i8_minus_one(127))
+    assert(is_not_five(-6))
+    assert(clear_low_byte(0x1234) == 0x1200)
+}
diff --git a/crates/fe/tests/fixtures/fe_test/dynamic_offset_overflow.fe b/crates/fe/tests/fixtures/fe_test/dynamic_offset_overflow.fe
