// SPDX-License-Identifier: MIT
// DeltaResolver settlement sequencing and PositionManager's Permit2 payment.
use std::abi::{sol::{self, Uint160}}
use std::evm::{Address, Ctx, Call, RawMem, revert}
use super::currency::Currency

msg SettlementMsg {
    #[selector = sol("sync(address)")]
    Sync { currency: Address },
    #[selector = sol("take(address,address,uint256)")]
    Take { currency: Address, to: Address, amount: u256 },
    #[selector = sol("settle()")]
    Settle {} -> u256,
}
msg Permit2Msg {
    #[selector = sol("transferFrom(address,address,uint160,address)")]
    TransferFrom { from: Address, to: Address, amount: Uint160, token: Address },
}

// Virtual payment, amount-mapping and take hooks from DeltaResolver.
// Defaults retain ordinary-token behavior; permissioned consumers override them.
pub trait TokenPayer {
    fn pay(self, _ manager: Address, _ token: Address, _ payer: Address, _ amount: u256)
    uses (ctx: Ctx, call: mut Call, mem: mut RawMem)

    fn map_settle(self, _ manager: Address, _ amount: u256, _ currency: Address) -> u256
    uses (ctx: Ctx, call: mut Call, mem: mut RawMem)
    {
        super::delta_resolver::map_settle(manager, amount, currency)
    }
    fn take(self, _ manager: Address, _ currency: Address, _ recipient: Address, _ amount: u256)
    uses (ctx: Ctx, call: mut Call, mem: mut RawMem)
    {
        super::payments::take(manager, currency, recipient, amount)
    }
}
pub struct Permit2Payment { pub permit2: Address }
impl Copy for Permit2Payment {}
impl TokenPayer for Permit2Payment {
    fn pay(self, _ manager: Address, _ token: Address, _ payer: Address, _ amount: u256)
    uses (ctx: Ctx, call: mut Call, mem: mut RawMem)
    {
        if payer == ctx.address() {
            Currency { address: token }.transfer(manager, amount)
        } else {
            // Solidity checks code existence for calls with no return values.
            if ctx.extcodesize(self.permit2) == 0 {
                revert(())
            }
            // The pinned PositionManager deliberately truncates to uint160.
            call.call(
                addr: self.permit2,
                gas: ctx.gas(),
                value: 0,
                message: Permit2Msg::TransferFrom {
                    from: payer,
                    to: manager,
                    amount: Uint160 { val: amount & 0xffffffffffffffffffffffffffffffffffffffff },
                    token,
                },
            )
        }
    }
}
pub fn take(_ manager: Address, _ currency: Address, _ recipient: Address, _ amount: u256)
uses (ctx: Ctx, call: mut Call)
{
    if amount == 0 { return }
    if ctx.extcodesize(manager) == 0 {
        revert(())
    }
    call.call(
        addr: manager,
        gas: ctx.gas(),
        value: 0,
        message: SettlementMsg::Take { currency, to: recipient, amount },
    )
}
pub fn settle<P: TokenPayer>(
    _ payment: P,
    _ manager: Address,
    _ currency: Address,
    _ payer: Address,
    _ amount: u256,
)
uses (ctx: Ctx, call: mut Call, mem: mut RawMem)
{
    if amount == 0 { return }
    if ctx.extcodesize(manager) == 0 {
        revert(())
    }
    call.call(
        addr: manager,
        gas: ctx.gas(),
        value: 0,
        message: SettlementMsg::Sync { currency },
    )
    if currency.inner == 0 {
        let _ = call
            .call(
                addr: manager,
                gas: ctx.gas(),
                value: amount,
                message: SettlementMsg::Settle {},
            )
    } else {
        payment.pay(manager, currency, payer, amount)
        let _ = call
            .call(
                addr: manager,
                gas: ctx.gas(),
                value: 0,
                message: SettlementMsg::Settle {},
            )
    }
}
