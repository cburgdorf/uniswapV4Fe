pub use full_math
pub use bit_math

/// Solidity require(bool): revert without error data.
pub fn require(_ condition: bool) {
    if !condition {
        std::evm::revert(())
    }
}

#[test(should_revert)]
fn require_rejects_false() {
    require(false)
}

