// SPDX-License-Identifier: MIT
// Pinned V4Quoter swap simulation. Results are communicated through reverts.
use core::abi::{AbiSize, Decode, Encode, ByteInput, store_word}
use core::ptr::{self, MemBuffer}
use std::abi::{Bytes, Bytes32, DynArray, Sol, sol::{self, Uint24, Int24, Uint160}}
use std::evm::{Address, Ctx, Call, RawMem, revert_error}
use std::evm::packed::keccak_packed
use super::{
    pool_types::{PoolKey, SwapParams},
    balance_delta::BalanceDelta,
    path_key::PathKey,
    tick_math,
}

pub type QuoteSingle = (PoolKey, bool, u128, Bytes)
pub type QuotePath = PathKey
pub type QuoteMulti = (Address, DynArray<QuotePath>, u128)
#[error]
pub struct QuoteSwap { pub amount: u256 }
#[error]
pub struct UnexpectedRevertBytes { pub revertData: Bytes }
#[error]
pub struct NotEnoughLiquidity { pub poolId: Bytes32 }
#[error]
pub struct NotSelf {}
#[error]
pub struct UnexpectedCallSuccess {}
#[error]
pub struct NotPoolManager {}

msg SwapMsg {
    #[selector = sol(
        "swap((address,address,uint24,int24,address),(bool,int256,uint160),bytes)",
    )]
    Swap { key: PoolKey, params: SwapParams, hookData: Bytes } -> i256,
}
pub fn parse_unlock_quote(_ reason: Bytes, _ encoded_len: u256) -> u256 uses (mem: RawMem) {
    let data = reason.payload_span()
    if data.len() < 4 || (mem.mload(data.ptr()) >> 224) != (sol("QuoteSwap(uint256)") as u256) {
        revert_error(UnexpectedRevertBytes { revertData: reason })
    }
    let amount = mem.mload(ptr::offset_bytes(data.ptr(), 4))
    // solc's catch buffer reuses the unlock call's scratch space. Its unchecked
    // quote load sees the encoded argument length in bytes missing from a short
    // QuoteSwap payload (the word at call-buffer offset 36). Reproduce that
    // observable result explicitly, without depending on Fe's memory allocator.
    if data.len() < 36 {
        let missing = !(0 as u256) >> ((data.len() - 4) * 8)
        return (amount & !missing) | (encoded_len & missing)
    }
    amount
}
fn swap(
    _ manager: Address,
    _ key: PoolKey,
    _ direction: bool,
    _ amount: i256,
    _ hook: own Bytes,
) -> BalanceDelta
uses (ctx: Ctx, call: mut Call, mem: mut RawMem)
{
    let delta = BalanceDelta {
        bits: call.call(
            addr: manager,
            gas: ctx.gas(),
            value: 0,
            message: SwapMsg::Swap {
                key,
                params: SwapParams {
                    zeroForOne: direction,
                    amountSpecified: amount,
                    sqrtPriceLimitX96: Uint160 {
                        val: if direction {
                            tick_math::MIN_SQRT_PRICE + 1
                        } else {
                            tick_math::MAX_SQRT_PRICE - 1
                        },
                    },
                },
                hookData: hook,
            },
        ),
    }
    let actual = if direction == (amount < 0) {
        delta.amount0()
    } else {
        delta.amount1()
    }
    if (actual as i256) != amount {
        revert_error(
            NotEnoughLiquidity {
                poolId: Bytes32 {
                    val: keccak_packed(
                        (
                            key.currency0.inner,
                            key.currency1.inner,
                            key.fee.val as u256,
                            key.tickSpacing.val as i256,
                            key.hooks.inner,
                        ),
                    ),
                },
            },
        )
    }
    delta
}
pub fn path_at(_ paths: DynArray<QuotePath>, _ index: u256) -> QuotePath {
    let data = paths.encoded_span()
    let offset = 32 + data.word_at(32 + index * 32)
    <QuotePath as Decode<Sol>>::decode_from(data, offset)
}
// DynArray retains its original wire layout. Normalize path tuples before
// forwarding memory parameters, as Solidity abi.encodeCall does.
pub fn canonical_paths(_ paths: DynArray<QuotePath>) -> DynArray<QuotePath> {
    let count = paths.len()
    let mut size = 32 + count * 32
    let mut i: u256 = 0
    while i < count {
        size += path_at(paths, i).payload_size()
        i += 1
    }
    let buffer = MemBuffer::alloc(size)
    store_word(ptr: buffer.ptr(), value: count)
    let mut tail = 32 + count * 32
    i = 0
    while i < count {
        let item = path_at(paths, i)
        let item_size = item.payload_size()
        store_word(
            ptr: ptr::offset_bytes(buffer.ptr(), 32 + i * 32),
            value: tail - 32,
        )
        <QuotePath as Encode<Sol>>::encode(item, ptr::offset_bytes(buffer.ptr(), tail))
        tail += item_size
        i += 1
    }
    DynArray::from_abi_tail(data: buffer.ptr(), len: count, size)
}
pub fn argument_struct() -> super::calldata_decoder::View {
    super::calldata_decoder::View { offset: 4 + std::evm::CallData::new().word_at(4), len: 0 }
}
pub fn single_view(_ manager: Address, _ p: super::calldata_decoder::View, _ exact_out: bool) -> !
uses (ctx: Ctx, call: mut Call, mem: mut RawMem)
{
    let hook = super::router_params::array(p.offset, 224, 1).bytes()
    let amount = super::router_params::uint128(p.word(192))
    let signed: i128 = amount.downcast_truncate()
    let specified = if exact_out {
        amount as i256
    } else {
        -(signed as i256)
    }
    let direction = super::router_params::boolean(p.word(160))
    let key = super::calldata_decoder::pool_key(p.offset)
    let delta = swap(manager, key, direction, specified, hook)
    quote_delta(delta, direction, exact_out)
}
fn quote_delta(_ delta: BalanceDelta, _ direction: bool, _ exact_out: bool) -> ! {
    let amount: u128 = if exact_out {
        let spent = if direction {
            delta.amount0()
        } else {
            delta.amount1()
        }
        (-spent).downcast_truncate()
    } else {
        let received = if direction {
            delta.amount1()
        } else {
            delta.amount0()
        }
        received.downcast_truncate()
    }
    revert_error(QuoteSwap { amount: amount as u256 })
}
pub fn multi_view(_ manager: Address, _ p: super::calldata_decoder::View, _ exact_out: bool) -> !
uses (ctx: Ctx, call: mut Call, mem: mut RawMem)
{
    let paths = super::router_params::array(p.offset, 32, 32)
    let mut amount = super::router_params::uint128(p.word(64))
    let mut currency = super::router_params::address(p.word(0))
    let mut step: u256 = 0
    while step < paths.len {
        let index = if exact_out {
            paths.len - 1 - step
        } else {
            step
        }
        let path = super::router_params::path_at(paths, index)
        let (key, forward) = super::router_params::path_pool(path, currency)
        let hook = super::router_params::array(path.offset, 128, 1).bytes()
        let direction = if exact_out { !forward } else { forward }
        let signed: i128 = amount.downcast_truncate()
        let specified = if exact_out {
            amount as i256
        } else {
            -(signed as i256)
        }
        let delta = swap(manager, key, direction, specified, hook)
        amount = if exact_out {
            let spent = if direction {
                delta.amount0()
            } else {
                delta.amount1()
            }
            (-spent).downcast_truncate()
        } else {
            let received = if direction {
                delta.amount1()
            } else {
                delta.amount0()
            }
            received.downcast_truncate()
        }
        currency = super::router_params::address(path.word(0))
        step += 1
    }
    revert_error(QuoteSwap { amount: amount as u256 })
}
